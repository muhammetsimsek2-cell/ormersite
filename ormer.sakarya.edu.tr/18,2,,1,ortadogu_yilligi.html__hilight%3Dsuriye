    <li><a target="_blank" href="https://plusone.google.com/_/+1/confirm?hl=en&url=http%3A%2F%2Former.sakarya.edu.tr%2F18%2C2%2C%2C1%2Cortadogu_yilligi.html"><i class="social google-plus"></i></a></li>
    <li><a target="_blank" href="https://www.facebook.com/sharer/sharer.php?u=http%3A%2F%2Former.sakarya.edu.tr%2F18%2C2%2C%2C1%2Cortadogu_yilligi.html"><i class="social facebook"></i></a></li>
