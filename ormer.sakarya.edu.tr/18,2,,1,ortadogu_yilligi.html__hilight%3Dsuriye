        <h2>Ortadoğu Yıllığı</h2>
        <div class="postmeta col-md-6 notprint">
          &nbsp;
        </div>
        <div class="sidebar col-md-6 notprint">
            <ul class="social-icons">
    <li><a target="_blank" href="https://www.linkedin.com/cws/share?url=http%3A%2F%2Former.sakarya.edu.tr%2F18%2C2%2C%2C1%2Cortadogu_yilligi.html"><i class="social linkedin"></i></a></li>
