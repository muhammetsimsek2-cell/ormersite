$(document).ready(function() {
  if(PDFObject.supportsPDFs){
    $('a').click(
      function(e){
        if (this.href.split('.').pop() === 'pdf') {
          e.preventDefault();

          var url = this.href.substr( this.href.lastIndexOf("/") + 1 );
          url = "1,6,.html?popup=inline&file=" + encodeURIComponent( btoa( url ));

          $.colorbox({iframe:true, width:"900px", height:"750px", href: url})
        }
      }
    );
  }
});

$(document).ready(function () {
  $("article.post .entry-summary img").each(function () {
    var maxWidth = $(this).parent().width() - 10;
    var ratio = 0;
    var width = $(this).width();
    var height = $(this).height();

    if (width > maxWidth) {
      ratio = (maxWidth / width);
      $(this).attr({
        width : maxWidth,
        height : (height * ratio),
        alt : ""
      });
    }
  });
});

